# Local plant (Python sim). Web and staff talk here for the summit demo.
PLANT_HOST=0.0.0.0
PLANT_PORT=8787
SITE_ID=elcia-emc
DEMO_TAU_MIN=2.0
TICK_SEC=1.0

# Optional MQTT (schema is always shown; broker is not required).
# MQTT_HOST=broker.hivemq.com
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Web LAN override (dev uses the Vite proxy; leave unset locally).
# VITE_PLANT_URL=http://localhost:8787

# Staff (Expo) — phone must use the laptop LAN IP, not 127.0.0.1.
# EXPO_PUBLIC_PLANT_URL=http://192.168.x.x:8787

# Dedicated CryoDispatch Supabase project (ap-south-1). Plant-only writes.
# Never put SUPABASE_SERVICE_ROLE_KEY in VITE_*, EXPO_PUBLIC_*, or INGEST_KEY.
# Do not point ESP32 firmware at functions/v1/ingest — that function returns 410.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional cloud client path. Summit default is LAN — leave these unset so web
# stays on SSE and staff stays on EXPO_PUBLIC_PLANT_URL. Uncomment only the anon
# key (never the service role) if clients should use Realtime.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
